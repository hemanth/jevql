{
  "name": "jev-ql",
  "version": "0.1.0",
  "description": "PostgreSQL-compatible query language powered by TypeSafe Jev System One models",
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "bin": {
    "jev-ql": "bin/jevql.js",
    "jevql": "bin/jevql.js"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:py": "PYTHONPATH=python python3 -m unittest discover -s python/tests",
    "bench": "node bench/run_bench.mjs",
    "demo": "node examples/basic.js",
    "playground": "node serve-playground.mjs"
  },
  "files": [
    "bin",
    "src",
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "author": "Hemanth HM <hemanth@h3manth.com> (https://h3manth.com)",
  "license": "MIT",
  "keywords": [
    "sql",
    "postgres",
    "typesafe",
    "jev",
    "ai",
    "query-language",
    "system-one",
    "noul",
    "semantic-sql"
  ],
  "dependencies": {
    "webml-kit": "^0.4.0"
  }
}
